// ===================
// Project
// ===================
model Project {
    id          String   @id @default(cuid())
    name        String
    description String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    metadata    Json?
    // Required relationship to User
    ownerId     String
    owner       User     @relation(fields: [ownerId], references: [id])
    // One-to-many relationship with Task
    tasks       Task[]
}
