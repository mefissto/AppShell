{
  "name": "backend",
  "version": "0.0.1",
  "type": "commonjs",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env APP_ENV=development nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "prisma:generate": "prisma generate && node ./scripts/post-prisma-generate.cjs",
    "prisma:migrate:dev": "cross-env APP_ENV=development npx prisma migrate dev",
    "prisma:seed": "npx prisma db seed",
    "prisma:seed:dev": "cross-env APP_ENV=development npx prisma db seed",
    "prisma:seed:e2e": "cross-env APP_ENV=e2e npx prisma db seed",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "npm run test -- --watch --verbose",
    "test:cov": "npm run test -- --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk node_modules/jest/bin/jest.js --runInBand",
    "pretest:e2e": "node scripts/e2e-setup.js",
    "pretest:e2e:bash": "bash scripts/e2e-setup.sh",
    "test:e2e": "cross-env APP_ENV=e2e NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "cron-validate": "^1.5.3",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "nestjs-cls": "7.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.7.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "30.5.2",
    "pg": "^8.18.0",
    "prettier": "^3.8.1",
    "prisma": "7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "29.4.15",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.14.1 <12"
  },
  "jest": {
    "setupFiles": [
      "reflect-metadata"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.spec.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@constants/(.*)$": "<rootDir>/common/constants/$1",
      "^@enums/(.*)$": "<rootDir>/common/enums/$1",
      "^@interfaces/(.*)$": "<rootDir>/common/interfaces/$1",
      "^@entities/(.*)$": "<rootDir>/common/entities/$1",
      "^@filters/(.*)$": "<rootDir>/common/filters/$1",
      "^@utils/(.*)$": "<rootDir>/common/utils/$1",
      "^@decorators/(.*)$": "<rootDir>/common/decorators/$1",
      "^@guards/(.*)$": "<rootDir>/common/guards/$1",
      "^@pagination/(.*)$": "<rootDir>/common/pagination/$1",
      "^@config/(.*)$": "<rootDir>/config/$1",
      "^@generated/(.*)$": "<rootDir>/../generated/$1",
      "^@database/(.*)$": "<rootDir>/database/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@system/(.*)$": "<rootDir>/system/$1",
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@loggers/(.*)$": "<rootDir>/common/loggers/$1",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
